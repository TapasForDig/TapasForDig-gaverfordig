# Uden DATABASE_URL kører appen på en lokal Postgres (PGlite) i mappen .data/
# Med Supabase: indsæt connection string fra Supabase → Project Settings → Database
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Den offentlige adresse, som bruges i links i mails
APP_URL=http://localhost:3000

# Mail: uden RESEND_API_KEY bliver mails kun gemt i admin → Mails (til test)
# RESEND_API_KEY=
# MAIL_FROM="Gaver For Dig <gaver@gaverfordig.dk>"
